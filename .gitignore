# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Local Secrets (Never commit secrets!)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Build & Distribution Artifacts
dist/
build/
*/dist/
*/build/

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & Editor Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Uploads & Media (Preserve structure with .gitkeep, exclude user uploads)
uploads/*
!uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep
server/uploads/*/*
!server/uploads/*/.gitkeep

